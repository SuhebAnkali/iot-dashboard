# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=water_iot_db

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ESP32 device
ESP32_IP=192.168.1.50
ESP32_TIMEOUT_MS=3000
POLL_INTERVAL_MS=5000

# Default seed accounts (only used by `npm run seed`)
SEED_OPERATOR_EMAIL=operator@iot.local
SEED_OPERATOR_PASSWORD=Operator@123
SEED_USER_EMAIL=viewer@iot.local
SEED_USER_PASSWORD=Viewer@123
